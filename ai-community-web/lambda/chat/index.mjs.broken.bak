13. ?˜è—¥?å?æ¶‰å??æ?äº‹é?ï¼Œè?? ä??è²¬?ç¤º`;

async function handleChat(body) {
  const text    = (body.text || '').trim();
  const image   = body.image || null; // base64 encoded image
  const imageMediaType = body.image_media_type || 'image/jpeg';
  const history = (body.history || []).slice(-30);
  const preferences = body.preferences || {};
  const accountId = body.account_id || '';

  // å¦‚æ??ç«¯æ²’å¸¶?å¥½ä½†æ? account_idï¼Œå? DynamoDB è®€??
  let userPrefs = preferences;
  if (accountId && Object.keys(preferences).length === 0) {
    try {
      const stored = await dbGet('user_preferences', { inbr_account_id: accountId });
      if (stored) {
        const { inbr_account_id, updated_at, ...rest } = stored;
        userPrefs = rest;
      }
    } catch (e) {
      console.error('[Prefs read error]', e);
    }
  }

  if (!text && !image) return fail('è¨Šæ¯ä¸èƒ½?ºç©º');

  const messages = [];
  for (const msg of history) {
    if (!msg.role || !msg.content) continue;
    messages.push({ role: msg.role, content: msg.content });
  }

  // çµ„å??¶å?ä½¿ç”¨?…è??¯ï??¯æ´å¤šæ¨¡?‹ï??‡å? + ?–ç?ï¼?
  if (image) {
    const userContent = [];
    userContent.push({
      type: 'image',
      source: { type: 'base64', media_type: imageMediaType, data: image },
    });
    userContent.push({
      type: 'text',
      text: text || 'è«‹å??é€™å¼µ?§ç?ï¼Œè¾¨è­˜å?é¡Œé??‹ã€åš´?ç?åº¦ï?ä¸¦é?ä¼°ç¶­ä¿®å·¥?‚è??ƒè€ƒå ±?¹ã€?,
    });
    messages.push({ role: 'user', content: userContent });
  } else {
    if (!messages.length || messages[messages.length - 1]?.content !== text) {
      messages.push({ role: 'user', content: text });
    }
  }

  // ?µæ¸¬?¯å¦æ¶‰å?é¤å»³/è¨‚ä?ï¼Œå? DynamoDB ?“é?å»³æ??®æ³¨??prompt
  const bookingKeywords = ['??, 'é¤å»³', 'è¨‚ä?', '?¨é?', '?šé?', '?šé?', '?ˆé?', '?©é?', '?ƒé£¯', 'ç´„å?', '?¨è–¦'];
  const allText = messages.map(m => typeof m.content === 'string' ? m.content : '').join(' ');
  const isBookingRelated = bookingKeywords.some(kw => allText.includes(kw));

  let vendorPromptAppend = '';
  if (isBookingRelated) {
    try {
      const vendors = await dbScan('cms_service_vendor',
        'service_type = :st AND is_enable = :e',
        { ':st': 6, ':e': '1' }
      );
      if (vendors.length > 0) {
        const vendorList = vendors
          .sort((a, b) => (Number(b.rating_avg) || 0) - (Number(a.rating_avg) || 0))
          .map(v => `- ${v.name}ï¼?{v.description}ï¼Œè???${v.rating_avg}ï¼‰`)
          .join('\n');
        vendorPromptAppend = `\n\n?ç³»çµ±è??™ï?å¹³å°?ˆä?é¤å»³æ¸…å–®?‘\n?¶ä½¿?¨è€…å??‰å“ªäº›é?å»³å¯?¸æ?ï¼Œåª?½å?ä»¥ä?æ¸…å–®?¨è–¦ï¼Œä??¯è‡ªè¡Œç·¨? é?å»³å?ç¨±ï?\n${vendorList}\n\n?¨è–¦?‚ä?ä½¿ç”¨?…å?å¥½ç??™ç?é¡å?ç¯©é¸ï¼Œæ?å¤šå???3-5 ?“ä??¸æ??‚`;
      }
    } catch (vendorErr) {
      console.error('[Vendor fetch error]', vendorErr);
    }
  }

  // çµ„å?ä½æˆ¶?å¥½?ç¤º
  let prefsPrompt = '';
  const accountName = body.account_name || '';
  const accountPhone = body.account_phone || '';

  // å¸³è??ºæœ¬è³‡æ?ï¼ˆç™»?¥æ??„å??å??»è©±ï¼?
  const accountInfo = [];
  if (accountName) accountInfo.push(`å¸³è?å§“å?ï¼?{accountName}`);
  if (accountPhone) accountInfo.push(`å¸³è??»è©±ï¼?{accountPhone}`);

  if (accountInfo.length > 0 || Object.keys(userPrefs).length > 0) {
    const prefsLines = [...accountInfo];
    if (userPrefs.address) prefsLines.push(`å¸¸ç”¨?°å?ï¼?{userPrefs.address}`);
    if (userPrefs.phone) prefsLines.push(`å¸¸ç”¨?¯çµ¡?»è©±ï¼?{userPrefs.phone}`);
    if (userPrefs.contactName) prefsLines.push(`å¸¸ç”¨?¯çµ¡äººï?${userPrefs.contactName}`);
    if (userPrefs.paymentMethod) prefsLines.push(`??”¨ä»˜æ¬¾?¹å?ï¼?{userPrefs.paymentMethod}`);
    if (userPrefs.favoriteRestaurants) prefsLines.push(`?œå¥½é¤å»³ï¼?{userPrefs.favoriteRestaurants}`);
    if (userPrefs.dietaryNotes) prefsLines.push(`é£²é??™è¨»ï¼?{userPrefs.dietaryNotes}`);

    prefsPrompt = `\n\n?ä??¶è??™è??å¥½??
${prefsLines.join('\n')}

ä½¿ç”¨è¦å?ï¼?
- ?¶é?è¦è¯çµ¡äººå§“å??Œé›»è©±æ?ï¼Œä¸»?•è©¢?ï??Œè??´æ¥ä½¿ç”¨?¨å¸³?Ÿç?å§“å?ï¼?{accountName || '?ªè¨­å®?}ï¼‰å??»è©±ï¼?{accountPhone || '?ªè¨­å®?}ï¼‰å?ï¼Ÿã€?
- ?¥ä??¶æ?å¸¸ç”¨?°å?ï¼Œè©¢?ï??Œè??åˆ°è·Ÿä?æ¬¡ä?æ¨???°å??ï?ï¼?{userPrefs.address || ''}ï¼‰ã€?
- ?¥ä??¶æ???”¨ä»˜æ¬¾?¹å?ï¼Œè©¢?ï??Œä?æ¨?”¨${userPrefs.paymentMethod || ''}ä»˜æ¬¾?ï???
- ä½¿ç”¨?…å??å°±?´æ¥å¸¶å…¥ï¼Œä??Œæ?å°±é??°è©¢?`;
  }

  // ?–ç?è¾¨è??¨ç? system prompt ?„å?
  let systemPrompt = CHAT_SYSTEM_PROMPT + vendorPromptAppend + prefsPrompt;
  if (image) {
    systemPrompt += `\n\n?å??‡è¾¨è­˜æ¨¡å¼ã€?
ä½¿ç”¨?…ä??³ä?ä¸€å¼µç¾?´ç…§?‡ï?è«‹ä?ï¼?
1. è¾¨è??§ç?ä¸­ç??é?é¡å?ï¼ˆå?ï¼šæ?æ°´ã€ç?å£è?ç¸«ã€ç®¡ç·šç ´?ã€å®¶?»æ??œã€é?æ±¡ç?åº¦ç?ï¼?
2. è©•ä¼°?å?/é«’æ±¡?´é?ç¨‹åº¦ï¼ˆè?å¾?ä¸­ç?/?´é?ï¼?
3. ?ä¼°ç¶­ä¿®?–æ?æ½”å·¥?‚ï?ä¾‹å?ï¼šç? 1-2 å°æ?ï¼?
4. ?ä??ƒè€ƒå ±?¹ç??ï?ä¾‹å?ï¼šç? NT$ 800-1,500ï¼?
5. å»ºè­°?€è¦ç??å?é¡å?ï¼ˆä¿®ç¹?æ¸…æ?/?¶ä?ï¼?

?¨æ??—æ–¹å¼æ?æ¥šå?è¦†ï??¶å?ç¹¼ç?è©¢å?ä½¿ç”¨?…æ˜¯?¦è??ç?æ­¤æ??™ã€‚`;
  }

  try {
    const cmd = new InvokeModelCommand({
      modelId: MODEL_ID,
      contentType: 'application/json',
      accept: 'application/json',
      body: JSON.stringify({
        anthropic_version: 'bedrock-2023-05-31',
        max_tokens: 2048,
        temperature: 0.7,
        system: systemPrompt,
        messages,
      }),
    });
    const res  = await bedrock.send(cmd);
    const data = JSON.parse(new TextDecoder().decode(res.body));
    const raw  = data.content?.[0]?.text?.trim() || '';

    // ?µæ¸¬?€?‹æ?è¨?
    const confirmMatch = raw.match(/\[CONFIRM:([^\]]+)\]/);
    const submitMatch  = raw.match(/\[SUBMIT:([^\]]+)\]/);
    const reply = raw
      .replace(/\[CONFIRM:[^\]]+\]/g, '')
      .replace(/\[SUBMIT:[^\]]+\]/g, '')
      .trim();

    const svcMap = {
      'å¤–é€?: 1, 'é¤å»³å¤–é€?: 1,
      'è¨‚ä?': 1, 'é¤å»³è¨‚ä?': 1,
      'æ¸…æ?': 3, 'å±…å®¶æ¸…æ?': 3,
      'ä¿®ç?': 3, 'æ°´é›»ä¿®ç?': 3,
      'å®…é?': 4, '?…è£¹å¯„é€?: 4, 'å¯„ä»¶': 4,
      'è³¼ç‰©': 2, '?†å?è³¼è²·': 2,
      '?«è?': 3, 'è¨ˆç?è»?: 3,
      '?˜è—¥': 3, 'ä»???¥å?': 3,
    };

    let formId = null;
    let service = null;
    let status = 'chatting'; // chatting | collecting | complete
    let feedbackNo = null;
    let collected = null;

    if (submitMatch) {
      service = submitMatch[1];
      formId  = svcMap[service] || 3;
      status  = 'complete';

      // ?ªå?å»ºç?è«®è©¢??
      feedbackNo = 'FB' + Date.now();
      collected = { service, history_summary: reply };

      const now = new Date().toISOString();

      try {
        await dbPut('pms_form_feedback', {
          feedback_no:     feedbackNo,
          form_id:         formId,
          platform_code:   '01',
          inbr_account_id: accountId,
          contact_name:    body.account_name || '',
          contact_mobile:  body.account_phone || '',
          description:     `AIå°è©±?ªå?å»ºå–®ï¼?{service}`,
          feedback_content: JSON.stringify({ source: 'ai_chat', service, reply }),
          status:          '01',
          is_read:         '0',
          cre_time:        now,
          upd_time:        now,
        });
      } catch (dbErr) {
        console.error('[Auto-submit feedback error]', dbErr);
      }

      // ?Œæ?å»ºç?è¨‚å–®ç´€?„ï?è®“è??®é??¢èƒ½?‹åˆ°ï¼?
      // ç¢ºä?è¨‚å–®é¡å??³å??¯å…«å¤§å?é¡ä?ä¸€
      // ?¹æ? service å°æ?å¤§å?é¡?
      let orderCategory = service;
      if (['ä¿®ç?', 'æ°´é›»ä¿®ç?'].includes(service)) orderCategory = 'ä¿®ç?';
      else if (['æ¸…æ?', 'å±…å®¶æ¸…æ?'].includes(service)) orderCategory = 'æ¸…æ?';
      else if (['å¤–é€?, 'é¤å»³å¤–é€?].includes(service)) orderCategory = 'å¤–é€?;
      else if (['è¨‚ä?', 'é¤å»³è¨‚ä?'].includes(service)) orderCategory = 'è¨‚ä?';
      else if (['å®…é?', '?…è£¹å¯„é€?, 'å¯„ä»¶'].includes(service)) orderCategory = 'å®…é?';
      else if (['è³¼ç‰©', '?†å?è³¼è²·'].includes(service)) orderCategory = 'è³¼ç‰©';
      else if (['?«è?', 'è¨ˆç?è»?].includes(service)) orderCategory = '?«è?';
      else if (['?˜è—¥', 'ä»???¥å?'].includes(service)) orderCategory = '?˜è—¥';

      // å¾å?è©±æ­·?²ä¸­?å??´å…·é«”ç??€æ±‚æ?è¿?
      const allHistory = messages.map(m => typeof m.content === 'string' ? m.content : '').join('\n');
      const detailMatch = allHistory.match(/?ª\s*(?:è©³ç´°?§å®¹|æ¸…æ?é¡å?|?€æ±‚é??‹|è»Šå??¸æ?|?é??è¿°|?†å?)ï¼?.+)/);
      const serviceDetail = detailMatch ? detailMatch[1].trim() : '';
      const serviceName = serviceDetail ? `${orderCategory} - ${serviceDetail}` : orderCategory;

      const recordId = Date.now();
      try {
        await dbPut('mms_order_record', {
          record_id:         recordId,
          order_no:          'ORD' + recordId,
          inbr_account_id:   accountId,
          service_vendor_id: '',
          order_type:        '01',
          order_status:      '01',
          service_name:      serviceName,
          final_amount:      0,
          earn_points:       0,
          remark:            `AIå°è©±?€æ±‚ï?${serviceName}`,
          feedback_no:       feedbackNo,
          cre_time:          now,
          order_time:        now,
        });
      } catch (dbErr) {
        console.error('[Auto-submit order error]', dbErr);
      }
    } else if (confirmMatch) {
      service = confirmMatch[1];
      formId  = svcMap[service] || 3;
      status  = 'collecting';
    }

    // ?å¥½?²å???AI ?¨è??®ç¢ºèªå?ä¸»å?è©¢å??¨æˆ¶ï¼Œä??è‡ª?•æ???
    // AI ?ƒåœ¨?è?ä¸­å?ä¸?[SAVE_PREFS:JSON] æ¨™è?è¡¨ç¤º?¨æˆ¶?Œæ??²å?
    const prefsMatch = raw.match(/\[SAVE_PREFS:(.*?)\]/s);
    let extractedPrefs = null;
    if (prefsMatch) {
      try {
        extractedPrefs = JSON.parse(prefsMatch[1]);
        // å¯«å…¥ DynamoDB
        if (accountId && extractedPrefs) {
          const merged = { ...userPrefs, ...extractedPrefs };
          await dbPut('user_preferences', {
            inbr_account_id: accountId,
            ...merged,
            updated_at: new Date().toISOString(),
          });
        }
      } catch (e) {
        console.error('[Prefs save error]', e);
      }
    }

    // æ¸…é™¤æ¨™è?
    const cleanReply = reply.replace(/\[SAVE_PREFS:.*?\]/s, '').trim();

    return ok({
      reply: cleanReply,
      intent:      (confirmMatch || submitMatch) ? 'service' : 'none',
      status,
      has_form:    false,
      form_id:     formId,
      service,
      feedback_no: feedbackNo,
      collected,
      preferences: extractedPrefs || undefined,
      source:      'bedrock',
    });
  } catch (err) {
    console.error('[Bedrock Error]', err);
    return ok({
      reply: 'ä¸å¥½?æ€ï??‘ç¾?¨æ?é»å?ä¸é?ä¾†ï??¯ä»¥è«‹æ‚¨?èªªä¸€æ¬¡å?ï¼?,
      intent: 'none', status: 'chatting', has_form: false, form_id: null, service: null, source: 'fallback',
    });
  }
}
